# =====================================================================
# .gitattributes — типы файлов и правила их импорта в репозиторий.
# Репозиторий: «Генератор случайных цитат» (MDK0202)
# =====================================================================

# ---------------------------------------------------------------------
# 1. Текстовые файлы: единый формат переноса строк LF
# ---------------------------------------------------------------------
# Git сам определяет текстовые файлы и нормализует переводы строк к LF
* text=auto eol=lf

# Для исходного кода и файлов данных правило задано явно
*.py           text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.cfg          text eol=lf
*.toml         text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# ---------------------------------------------------------------------
# 2. Бинарные файлы: Git не пытается сравнивать в них строки
# ---------------------------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.exe  binary
*.dll  binary

# ---------------------------------------------------------------------
# 3. Тяжёлые ресурсы: импортируются через Git LFS
#    (строки ниже добавлены автоматически командой git lfs track)
# ---------------------------------------------------------------------
*.psd filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

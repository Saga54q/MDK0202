# =====================================================================
# .gitignore — фильтры импорта: файлы и каталоги, которые Git
# не должен отслеживать в этом репозитории.
#
# Часть шаблонов подготовлена с помощью сервиса gitignore.io (Toptal)
# (https://www.toptal.com/developers/gitignore) для набора:
# python, pycharm, windows, visualstudiocode, visualstudio.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Служебные файлы среды разработки
# ---------------------------------------------------------------------
# PyCharm / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/
!.vscode/extensions.json

# Visual Studio (C/C++): каталоги сборки и файлы настроек пользователя
Debug/
Release/
x64/
x86/
*.user
*.suo
*.sln.docstates

# Прочие редакторы
*.swp
*.swo
*~

# ---------------------------------------------------------------------
# 2. Зависимости и кэш (генерируются автоматически, воспроизводимы)
# ---------------------------------------------------------------------
# Python: кэш байт-кода
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.python-version

# Виртуальные окружения
venv/
.venv/
env/
ENV/

# Кэш инструментов тестирования и проверки кода
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Каталоги сборки и зависимостей других платформ (на будущее)
target/          # Rust / Java (Maven)
.target/         # утилиты .NET
node_modules/    # Node.js
dist/
build/

# ---------------------------------------------------------------------
# 3. Конфиденциальные данные
# ---------------------------------------------------------------------
# Секреты хранятся в переменных окружения или в локальном файле .env,
# который в репозиторий не публикуется (см. п. 4.3 отчёта № 2).
.env
.env.*
!.env.example
secrets.json
credentials.json
*.pem
*.key
*.p12

# config.json намеренно НЕ исключается: в нём только несекретные
# настройки (путь к quotes.json и язык интерфейса).

# ---------------------------------------------------------------------
# 4. Системные и временные файлы
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
Thumbs.db
desktop.ini
*.log
*.tmp
*.bak
~$*            # временные файлы Microsoft Word
